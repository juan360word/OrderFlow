# ---------------------------------------------------------------------------
# OrderFlow — environment template.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored; this file is committed. Never put a real secret here.
# ---------------------------------------------------------------------------

# -- Application --
APP_NAME=OrderFlow API
ENVIRONMENT=local          # local | development | testing | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# -- HTTP --
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*
MAX_REQUEST_BODY_BYTES=1048576

# -- Database (must match docker-compose.yml) --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000

# -- Security --
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-random-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=orderflow
JWT_AUDIENCE=orderflow-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# -- Inventory --
INVENTORY_LOCKING_STRATEGY=atomic_update   # atomic_update | pessimistic
INVENTORY_RESERVATION_TTL_MINUTES=30

# -- Idempotency (phase 8) --
# Must outlive any client's realistic retry window: a key deleted too early
# stops protecting the retry it exists for.
IDEMPOTENCY_RETENTION_HOURS=24

# -- Redis (phase 9) --
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_TIMEOUT_SECONDS=2.0
REDIS_MAX_CONNECTIONS=20
PRODUCT_CACHE_TTL_SECONDS=300
CACHE_TTL_JITTER_RATIO=0.1        # spreads expiry so keys do not all die at once
CACHE_REBUILD_LOCK_MS=3000        # single-flight window against a cache stampede
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ORDER_RATE_LIMIT_ATTEMPTS=30
ORDER_RATE_LIMIT_WINDOW_SECONDS=60

# -- Messaging (phases 10 and 11) --
# LocalStack emulates SQS locally. In AWS, leave AWS_ENDPOINT_URL empty and let
# the SDK resolve the real endpoint from the region.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
ORDERS_QUEUE_NAME=orderflow-orders
ORDERS_DLQ_NAME=orderflow-orders-dlq
SQS_WAIT_TIME_SECONDS=10          # long polling; 0 would busy-spin
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=3           # attempts before the message goes to the DLQ
MESSAGING_ENABLED=true
EVENT_DELIVERY_MODE=outbox        # outbox | direct  (direct loses events; see README)
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# -- Product pictures --
# The bytes live in PostgreSQL (table `product_images`), so the ceiling is kept
# low on purpose: every megabyte here is a megabyte in every backup. The upload
# endpoint is the one place that accepts a body larger than
# MAX_REQUEST_BODY_BYTES, and only by this much.
PRODUCT_IMAGE_MAX_BYTES=2097152

# -- Demo accounts (`make seed`) --
# The login screen advertises these two accounts. `make seed` creates them, and
# refuses to run when ENVIRONMENT is staging or production - the credentials are
# published in the UI, so they are demo data and nothing else. Override them for
# a shared demo deployment.
SEED_ADMIN_EMAIL=admin@orderflow.io
SEED_ADMIN_PASSWORD=Segura2024!XZ
SEED_ADMIN_NAME=Admin OrderFlow
SEED_CUSTOMER_EMAIL=cliente@orderflow.io
SEED_CUSTOMER_PASSWORD=Segura2024!XZ
SEED_CUSTOMER_NAME=Cliente Demo
