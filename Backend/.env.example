# ---------------------------------------------------------------------------
# OrderFlow — environment template.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored; this file is committed. Never put a real secret here.
# ---------------------------------------------------------------------------

# -- Application --
APP_NAME=OrderFlow API
ENVIRONMENT=local          # local | development | testing | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# -- HTTP --
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*
MAX_REQUEST_BODY_BYTES=1048576

# -- Database (must match docker-compose.yml) --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000

# -- Security --
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-random-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=orderflow
JWT_AUDIENCE=orderflow-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# -- Inventory --
INVENTORY_LOCKING_STRATEGY=atomic_update   # atomic_update | pessimistic
INVENTORY_RESERVATION_TTL_MINUTES=30
